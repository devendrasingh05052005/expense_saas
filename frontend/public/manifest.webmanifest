{
  "name": "RoomMates – Expense & Common Fund SaaS",
  "short_name": "RoomMates",
  "description": "Multi-Tenant Shared Room Expense & Common Fund Management Platform",
  "id": "roommates-expense-saas",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0B0F17",
  "theme_color": "#4F46E5",
  "categories": ["finance", "utilities", "productivity"],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Individual Expenses",
      "short_name": "Expenses",
      "description": "View and record personal out-of-pocket expenses",
      "url": "/expenses",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Settlement Hub",
      "short_name": "Settlements",
      "description": "View fair shares and debt transfers",
      "url": "/settlements",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Common Room Fund",
      "short_name": "Fund",
      "description": "Manage collective flat pool fund",
      "url": "/fund",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    }
  ]
