# ========================================================
# RoomMates SaaS - Environment Variables for Vercel / Cloud
# ========================================================

# Database (PostgreSQL URL e.g. from Neon.tech, Supabase, or Railway)
DATABASE_URL=postgresql://user:password@ep-sample.neon.tech/roommates?sslmode=require

# JWT Secret Key
SECRET_KEY=super-secret-key-roommates-saas-2026-very-secure

# Real Gmail SMTP Configuration for sending 6-digit OTPs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com
EMAILS_FROM_NAME=RoomMates App

# Dev mode (False in production)
DEV_MODE=False

# Optional: Frontend API URL (if hosting backend on a separate domain like Render/Railway)
# VITE_API_URL=https://your-backend.onrender.com
